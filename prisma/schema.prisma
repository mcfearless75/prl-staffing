generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users (internal staff) ───
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String
  role            String   @default("admin") // admin, manager, viewer
  failedAttempts  Int      @default(0)
  lockedUntil     DateTime?
  tokenVersion    Int      @default(0) // increment to invalidate all sessions
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Client Companies ───
model Company {
  id           String       @id @default(cuid())
  name         String
  address      String?
  city         String?
  postcode     String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  contractors   Assignment[]
  sites         Site[]
  requirements  ComplianceRequirement[]
  approvalChain ApprovalChain?
  invoices      Invoice[]
  projects      Project[]
  creditNotes   CreditNote[]
}

// ─── Suppliers (agencies) ───
model Supplier {
  id           String       @id @default(cuid())
  name         String
  tier         String       @default("Tier 2") // Tier 1, Tier 2, Tier 3
  contactName  String?
  contactEmail String?
  contactPhone String?
  score        Int          @default(0) // 0-100 performance score
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  contractors  Contractor[]
}

// ─── Contractors ───
model Contractor {
  id           String             @id @default(cuid())
  firstName    String
  lastName     String
  email        String             @unique
  personalEmail String?
  phone        String?
  jobTitle     String?
  dayRate      Float?
  payRate      Float?             // hourly pay rate
  chargeRate   Float?             // hourly charge rate
  status       String             @default("Inactive") // See src/lib/contractor-statuses.ts — New, Active, On Hold, Suspended, Inactive, Left, plus pipeline Applied/Looking
  // When staff explicitly approved this applicant. Set ONLY by a deliberate
  // individual approval — never by bulk import, onboarding create, or a
  // contractor going back to work. welcomeAgent keys off this; `updatedAt` was
  // used before and bumped on every write, so a backfill script read as a wave
  // of approvals and emailed contractors who had been on site for months.
  // Null means "not approved through PRISM", which is correct for everyone
  // predating this column and for imported records.
  approvedAt   DateTime?
  supplierId   String?
  supplier     Supplier?          @relation(fields: [supplierId], references: [id])
  niNumber     String?
  utrNumber    String?
  ir35Status   String?            // Inside, Outside, TBD
  employmentType String?          // PAYE, CIS, PSC
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?   // Spouse, Parent, Partner, Sibling, Friend, Other
  dateOfBirth              DateTime?
  address                  String?
  postcode                 String?
  latitude                 Float?    // geocoded from postcode, for coverage map
  longitude                Float?
  geocodedAt               DateTime? // last successful/attempted geocode, avoids re-querying on every backfill
  nextOfKin                String?
  medicalNotes             String?   // allergies, conditions (confidential)
  // ─── Right to work ───
  // Collected by /apply since launch but only ever written into the notes JSON
  // blob, so it was queryable by nobody and invisible to every screen. Promoted
  // to real columns because the expiry dates are exactly what complianceChase
  // needs to alert on. notes still keeps the full raw blob as the audit trail,
  // so a date that fails to parse is degraded, never lost.
  nonBritishNational       String?   // Yes / No as submitted
  requiresWorkPermit       String?   // Yes / No as submitted
  passportNumber           String?
  passportExpiry           DateTime?
  visaNumber               String?
  visaExpiry               DateTime?
  notes        String?
  ref          String?            @unique // human-readable reference, e.g. C00001
  inviteSentAt              DateTime?
  inviteOpenedAt            DateTime?
  inviteToken               String?   @unique
  profileCompletionSentAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  assignments  Assignment[]
  timesheets   Timesheet[]
  compliances      ComplianceRecord[]
  invoiceLines     InvoiceLine[]
  contractorLogin  ContractorLogin?
  documents        Document[]
  expenses         Expense[]
  noteEntries      ContractorNote[]
  holidayLedger    HolidayLedger[]
  holidayRequests  HolidayRequest[]
  chaseLogs        ChaseLog[]
  jobRoles         ContractorJobRole[]

  // These three indexes already exist in the database — the migrations that
  // added their columns created them directly in SQL, but never declared them
  // here. Prisma compares this schema against migration history, so an
  // undeclared index reads as drift: the next `prisma migrate dev` would
  // generate a migration DROPPING all three, silently degrading the compliance
  // expiry scans and welcomeAgent's approval lookup. Declaring them is a no-op
  // against the live database — the names match Prisma's own
  // <Table>_<column>_idx convention, which is what the SQL used.
  @@index([approvedAt])
  @@index([passportExpiry])
  @@index([visaExpiry])
}

// ─── Contractor Notes (append-only staff notes thread; NOT the Contractor.notes onboarding JSON blob) ───
model ContractorNote {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  body         String
  authorId     String?
  authorName   String
  isPinned     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ─── Holiday Ledger (accrual/payment/adjustment entries per contractor) ───
model HolidayLedger {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id])
  timesheetId  String?    // source timesheet for accruals; plain string FK, mirrors Expense.timesheetId pattern
  type         String     // Accrual, Payment, Adjustment
  hours        Float
  amount       Float?
  weekStarting DateTime?
  notes        String?
  createdBy    String?
  createdAt    DateTime   @default(now())
}

// ─── Holiday Requests (contractor-submitted, staff-reviewed) ───
model HolidayRequest {
  id             String     @id @default(cuid())
  contractorId   String
  contractor     Contractor @relation(fields: [contractorId], references: [id])
  hoursRequested Float
  status         String     @default("Pending") // Pending, Approved, Rejected, Paid
  requestedAt    DateTime   @default(now())
  reviewedBy     String?
  reviewedAt     DateTime?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// ─── Chase Log (record of chase communications sent to contractors) ───
model ChaseLog {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id])
  kind         String     // e.g. "timesheet"
  weekStarting DateTime?
  sentAt       DateTime   @default(now())
  sentBy       String?
}

// ─── Sites (physical locations under a Company) ───
model Site {
  id          String       @id @default(cuid())
  name        String
  address     String?
  city        String?
  postcode    String?
  latitude    Float?    // geocoded from postcode, for coverage map
  longitude   Float?
  geocodedAt  DateTime?
  isActive    Boolean      @default(true)
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  assignments Assignment[]
}

// ─── Departments (trade/function groupings under a Site) ───
model Department {
  id          String       @id @default(cuid())
  name        String
  isActive    Boolean      @default(true)
  siteId      String
  site        Site         @relation(fields: [siteId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
}

// ─── Assignments (contractor <-> company placement) ───
model Assignment {
  id             String      @id @default(cuid())
  contractorId   String
  contractor     Contractor  @relation(fields: [contractorId], references: [id])
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  siteId         String?
  site           Site?       @relation(fields: [siteId], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id])
  role           String
  location       String?
  startDate      DateTime
  endDate        DateTime?
  status         String      @default("Active") // See src/lib/assignment-statuses.ts — Placed, Active, Ending, Holiday, Completed
  poNumber       String?
  notes          String?
  chargeRate     Float?      // client charge rate for this assignment
  payRate        Float?      // contractor pay rate for this assignment
  rateBasis      String?     // Hourly, Daily
  comparatorRate Float?      // AWR comparable-employee rate
  awrExempt      Boolean     @default(false)
  awrStartDate   DateTime?   // manual override for AWR 12-week clock start
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  timesheets     Timesheet[]
  timesheetEntries TimesheetEntry[]
  expenses       Expense[]
  creditNotes    CreditNote[]
}

// ─── Projects (client jobs/contracts) ───
model Project {
  id            String       @id @default(cuid())
  code          String       @unique // e.g. "4034"
  name          String
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id])
  siteAddress   String?
  costCode      String?
  status        String       @default("Active") // Active, OnHold, Completed
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assignments   Assignment[]
  rateCards     RateCard[]
}

// ─── Timesheets ───
model Timesheet {
  id           String          @id @default(cuid())
  contractorId String
  contractor   Contractor      @relation(fields: [contractorId], references: [id])
  assignmentId String?
  assignment   Assignment?     @relation(fields: [assignmentId], references: [id])
  weekStarting DateTime        // Monday of the week
  status       String          @default("Draft") // Draft, Submitted, Approved, Rejected
  totalHours   Float           @default(0)
  overtimeHours Float          @default(0)
  notes        String?
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  isException     Boolean         @default(false)
  exceptionReason String?
  entries         TimesheetEntry[]
  auditLogs       TimesheetAuditLog[]
  approvals       TimesheetApproval[]
}

model TimesheetEntry {
  id              String      @id @default(cuid())
  timesheetId     String
  timesheet       Timesheet   @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  dayOfWeek       Int         // 0=Mon, 1=Tue, ... 6=Sun
  hours           Float       @default(0)
  overtime        Float       @default(0)
  startTime       String?     // "HH:MM" — when set with finishTime, hours are derived from these
  finishTime      String?     // "HH:MM"
  notes           String?
  status          String      @default("Pending") // Pending, Approved, Rejected, Absent
  rejectionReason String?
  absenceReason   String?
  assignmentId    String?
  assignment      Assignment? @relation(fields: [assignmentId], references: [id])
}

// ─── Compliance Records ───
model ComplianceRecord {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id])
  type         String     // CSCS, DBS, Right to Work, Insurance, IR35, Qualification
  documentName String?
  reference    String?    // cert number etc
  issueDate    DateTime?
  expiryDate   DateTime?
  indefiniteExpiry Boolean @default(false) // true = "No expiry" was explicitly set, distinct from not-yet-entered
  status       String     @default("Pending") // Verified, Pending, Expiring, Expired, Non-Compliant
  notes        String?
  filePath     String?    // path to uploaded document
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ─── Compliance Requirements (checklists per role/site) ───
model ComplianceRequirement {
  id          String   @id @default(cuid())
  role        String   // e.g. "Electrician", "Labourer", "All"
  companyId   String?  // null = applies to all sites
  company     Company? @relation(fields: [companyId], references: [id])
  type        String   // CSCS, DBS, Right to Work, Insurance, IR35 Assessment, Qualification
  description String?  // extra detail, e.g. "NVQ Level 3"
  isMandatory Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([role, companyId, type])
}

// ─── Timesheet Audit Log ───
model TimesheetAuditLog {
  id          String    @id @default(cuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  action      String    // Created, Edited, Submitted, Approved, Rejected, AutoApproved, Reopened
  field       String?   // which field changed (e.g. "hours_Mon", "status")
  oldValue    String?
  newValue    String?
  userId      String?   // who made the change
  userName    String?
  createdAt   DateTime  @default(now())
}

// ─── Approval Chains (multi-step approval per company) ───
model ApprovalChain {
  id        String         @id @default(cuid())
  companyId String?        @unique // null = default chain for all companies
  company   Company?       @relation(fields: [companyId], references: [id])
  name      String
  steps     ApprovalStep[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ApprovalStep {
  id              String        @id @default(cuid())
  approvalChainId String
  approvalChain   ApprovalChain @relation(fields: [approvalChainId], references: [id], onDelete: Cascade)
  stepOrder       Int           // 1, 2, 3...
  approverRole    String        // "manager", "admin"
  label           String        // "Line Manager", "Site Manager", "Finance"
  createdAt       DateTime      @default(now())
}

// ─── Timesheet Approval Steps (per-timesheet tracking) ───
model TimesheetApproval {
  id          String    @id @default(cuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  stepOrder   Int
  stepLabel   String
  status      String    @default("Pending") // Pending, Approved, Rejected
  approvedBy  String?
  approverName String?
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
}

// ─── Invoices ───
model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique // e.g. INV-0001
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  periodStart    DateTime      // billing period start
  periodEnd      DateTime      // billing period end
  status         String        @default("Draft") // Draft, Reconciling, Approved, Sent, Paid, Disputed
  currency       String        @default("GBP")
  subtotal       Float         @default(0)
  vatRate        Float         @default(20) // UK VAT %
  vatAmount      Float         @default(0)
  total          Float         @default(0)
  dueDate        DateTime?
  paidDate       DateTime?
  poNumber       String?       // PO reference for three-way matching
  notes          String?
  matchStatus    String        @default("Unmatched") // Unmatched, Partial, Matched, Disputed
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lines          InvoiceLine[]
  payments       InvoicePayment[]
  creditNotes    CreditNote[]
}

model InvoiceLine {
  id            String    @id @default(cuid())
  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id])
  timesheetId   String?
  expenseId     String?    // Expense id when this line bills an approved expense
  description   String     // e.g. "J. Smith - Electrician"
  hours         Float
  overtimeHours Float      @default(0)
  rate          Float      // charge rate per hour
  overtimeRate  Float?     // overtime rate (1.5x)
  amount        Float      // total line amount
  createdAt     DateTime   @default(now())
}

// ─── Credit Notes (adjustments against an Invoice) ───
model CreditNote {
  id               String      @id @default(cuid())
  creditNoteNumber String      @unique // e.g. CN-0001
  invoiceId        String
  invoice          Invoice     @relation(fields: [invoiceId], references: [id])
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id])
  assignmentId     String?
  assignment       Assignment? @relation(fields: [assignmentId], references: [id])
  amount           Float
  vatRate          Float       @default(20)
  vatAmount        Float
  total            Float
  reason           String
  status           String      @default("Draft") // Draft, Issued, Processed
  processedAt      DateTime?
  processedBy      String?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// ─── Invoice Payments (BACS/manual reconciliation against an Invoice) ───
model InvoicePayment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
  amount       Float
  receivedDate DateTime
  method       String   @default("BACS")
  reference    String?
  importBatch  String?
  notes        String?
  createdAt    DateTime @default(now())
}

// ─── Activity Log (tracks all user actions for audit) ───
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  userEmail   String?
  action      String   // e.g. "Created Contractor", "Approved Timesheet"
  entityType  String   // e.g. "Contractor", "Timesheet", "Invoice"
  entityId    String?
  details     String?  // JSON or text with additional context
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// ─── Contractor Login (self-service portal) ───
model ContractorLogin {
  id              String     @id @default(cuid())
  contractorId    String     @unique
  contractor      Contractor @relation(fields: [contractorId], references: [id])
  email           String     @unique
  failedAttempts  Int        @default(0)
  lockedUntil     DateTime?
  tokenVersion    Int        @default(0)
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ─── Payment Queries (ticket system) ───
model PaymentQuery {
  id                  String    @id @default(cuid())
  ticketNumber        String    @unique // PQ-001, PQ-002
  operativeName       String
  email               String
  phone               String?
  role                String?
  weekEnding          String
  queryType           String    // "Incorrect Hours, Overtime, No Payment" etc
  totalHoursClaimed   String?
  totalOvertimeClaimed String?
  totalHoursPaid      String?
  hours               String?   // JSON array of hour rows
  explanation         String
  signature           String
  status              String    @default("Open") // Open, Assigned, Resolved, Closed
  assignedTo          String?
  assignedAt          DateTime?
  resolvedAt          DateTime?
  resolvedBy          String?
  resolutionNotes     String?
  closedAt            DateTime?
  closedBy            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ─── Grievances (ticket system) ───
model Grievance {
  id              String    @id @default(cuid())
  ticketNumber    String    @unique // GRV-001, GRV-002
  name            String
  email           String
  phone           String?
  role            String?
  site            String?
  incidentDate    String?
  grievanceType   String    // "Bullying / Harassment, Discrimination" etc
  description     String
  desiredOutcome  String?
  raisedInformally String?  // "Yes" | "No"
  witnesses       String?
  signature       String
  status          String    @default("Open") // Open, Assigned, Resolved, Closed
  assignedTo      String?
  assignedAt      DateTime?
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?
  closedAt        DateTime?
  closedBy        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─── New Starter Checklist submissions (public /new-starter form) ───
model NewStarterSubmission {
  id                  String    @id @default(cuid())
  firstName           String
  lastName            String
  email               String
  phone               String
  gender              String?
  dob                 String?  // yyyy-mm-dd as submitted
  country             String?
  address             String?
  city                String?
  postcode            String?
  niNumber            String?
  employmentStartDate String
  employeeStatement   String   // A, B or C (HMRC starter declaration)
  signature           String
  status              String    @default("New") // New, Processed, Rejected
  notes               String?   // staff review notes
  contractorId        String?   // set once converted into a Subcontractor record
  processedAt         DateTime?
  processedBy         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ─── Policy Documents ───
model Policy {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   // "Compliance & Ethics", "Data & Privacy", "Health & Safety", "Business Operations", "Accreditations"
  filename    String
  r2Key       String   // "policies/filename.pdf"
  fileType    String   // "pdf" | "docx" | "xlsx"
  fileSize    Int?
  version     String?
  isPublic    Boolean  @default(false)
  sortOrder   Int      @default(0)
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── GDPR Consent Tracking ───
model ConsentRecord {
  id            String   @id @default(cuid())
  contractorId  String?
  email         String
  consentType   String   // "onboarding", "portal_registration", "data_processing", "marketing"
  consentGiven  Boolean  @default(true)
  ipAddress     String?
  userAgent     String?
  consentText   String?  // what they agreed to
  givenAt       DateTime @default(now())
  withdrawnAt   DateTime?

  @@index([contractorId])
  @@index([email])
}

// ─── GDPR Erasure Requests ───
model ErasureRequest {
  id            String   @id @default(cuid())
  contractorId  String?
  email         String
  requestedBy   String   // contractor email or staff email
  reason        String?
  status        String   @default("Pending") // Pending, Approved, Completed, Rejected
  processedBy   String?
  processedAt   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
}

// ─── Password Reset Tokens ───
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Document Uploads ───
model Document {
  id            String     @id @default(cuid())
  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id])
  type          String     // CSCS, CV, P45, P60, Passport, DBS, Insurance, Qualification, Other
  fileName      String
  fileSize      Int        // bytes
  mimeType      String
  storageKey    String     // R2 object key
  storageUrl    String?    // public URL if needed
  version       Int        @default(1)
  uploadedBy    String?    // "contractor" or user email
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// ─── Push Notification Subscriptions ───
model PushSubscription {
  id             String   @id @default(cuid())
  contractorId   String?
  userId         String?
  endpoint       String   @unique
  p256dh         String
  auth           String
  createdAt      DateTime @default(now())
}

// ─── Notifications ───
model Notification {
  id            String   @id @default(cuid())
  recipientType String   // "contractor" or "user"
  recipientId   String
  title         String
  body          String
  url           String?  // link to open when tapped
  isRead        Boolean  @default(false)
  sentAt        DateTime @default(now())
}

// ─── Rate Cards ───
model RateCard {
  id             String    @id @default(cuid())
  trade          String    // was "role" — e.g. "Banksman", "Slinger", "Quantity Surveyor"
  region         String?   // was "location" — e.g. "London & SE", "Midlands", "Ireland"
  sector         String?   // e.g. "Civils/Infra"
  project        String?   // legacy free text, superseded by projectId
  projectId      String?
  projectRef     Project?  @relation(fields: [projectId], references: [id])
  employmentType String    @default("PAYE") // CIS, PAYE, PSC
  rateType       String    @default("Time")  // Time, Piece
  rateBasis      String    @default("Hourly") // Hourly, Daily
  pay            Float     // was payRate — per hour or per day depending on rateBasis
  agencyMarkup   Float?    // markup added to pay to reach charge
  charge         Float     // was chargeRate
  margin         Float?    // percentage
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─── Expenses (contractor-incurred costs, billable to client) ───
model Expense {
  id                String     @id @default(cuid())
  contractorId      String
  contractor        Contractor @relation(fields: [contractorId], references: [id])
  assignmentId      String?
  assignment        Assignment? @relation(fields: [assignmentId], references: [id])
  timesheetId       String?    // plain string FK, mirrors InvoiceLine.timesheetId pattern
  date              DateTime
  category          String     // Travel, Accommodation, Materials, Other
  description       String
  amount            Float
  receiptDocumentId String?    // Document id
  status            String     @default("Pending") // Pending, Approved, Rejected, Invoiced
  reviewedBy        String?
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

// ─── QMS: Non-Conformance / CAPA ───
model NonConformance {
  id            String   @id @default(cuid())
  ncrNumber     String   @unique // NCR-001, NCR-002...
  title         String
  description   String
  category      String   // Process, Product, Service, Compliance, H&S, Documentation
  severity      String   @default("Minor") // Minor, Major, Critical
  source        String   // Internal Audit, Customer Complaint, Management Review, Observation, Incident
  raisedBy      String
  raisedDate    DateTime @default(now())
  assignedTo    String?
  rootCause     String?
  correctiveAction    String?
  preventiveAction    String?
  evidenceOfClosure   String?
  targetDate    DateTime?
  closedDate    DateTime?
  closedBy      String?
  status        String   @default("Open") // Open, In Progress, Awaiting Verification, Closed, Overdue
  verifiedBy    String?
  verifiedDate  DateTime?
  effectivenessReview String?
  effectivenessDate   DateTime?
  filePath      String?  // uploaded evidence
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── QMS: Internal Audits ───
model InternalAudit {
  id            String   @id @default(cuid())
  auditNumber   String   @unique // IA-2026-001
  title         String
  scope         String?  // which processes/areas
  auditDate     DateTime
  leadAuditor   String
  auditTeam     String?  // comma separated
  isoClause     String?  // e.g. "7.5, 8.1, 9.2"
  status        String   @default("Planned") // Planned, In Progress, Completed, Cancelled
  overallResult String?  // Conforming, Minor NC, Major NC, Observation
  summary       String?
  completedDate DateTime?
  nextAuditDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  findings      AuditFinding[]
}

model AuditFinding {
  id            String        @id @default(cuid())
  auditId       String
  audit         InternalAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  findingNumber Int           // 1, 2, 3...
  type          String        // NC Major, NC Minor, Observation, Opportunity for Improvement, Positive
  isoClause     String?       // specific clause reference
  description   String
  evidence      String?
  correctiveAction String?
  assignedTo    String?
  targetDate    DateTime?
  closedDate    DateTime?
  status        String        @default("Open") // Open, In Progress, Closed, Overdue
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ─── QMS: Management Reviews ───
model ManagementReview {
  id            String   @id @default(cuid())
  reviewNumber  String   @unique // MR-2026-Q1
  title         String
  reviewDate    DateTime
  chairperson   String
  attendees     String?  // comma separated
  status        String   @default("Scheduled") // Scheduled, In Progress, Completed
  // Agenda items (auto-populated from PRISM data)
  kpiSummary    String?  // JSON: {contractors, assignments, compliance, timesheets, billing}
  ncrSummary    String?  // JSON: {open, closed, overdue}
  auditSummary  String?  // JSON: {completed, findings, overdue}
  riskSummary   String?  // JSON: {high, medium, low}
  // Minutes
  minutes       String?  // rich text minutes
  decisions     String?  // key decisions made
  actions       String?  // JSON array of {action, owner, deadline}
  // Review outputs
  resourceNeeds String?
  improvements  String?
  nextReviewDate DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── QMS: Risk Register ───
model Risk {
  id            String   @id @default(cuid())
  riskNumber    String   @unique // RISK-001
  title         String
  description   String
  category      String   // Operational, Financial, Compliance, Reputational, H&S, IT/Data
  likelihood    Int      @default(3) // 1-5
  impact        Int      @default(3) // 1-5
  riskScore     Int      @default(9) // likelihood x impact
  riskLevel     String   @default("Medium") // Low, Medium, High, Critical
  owner         String
  existingControls String?
  additionalActions String?
  targetDate    DateTime?
  reviewDate    DateTime?
  lastReviewedBy String?
  lastReviewedAt DateTime?
  status        String   @default("Active") // Active, Mitigated, Closed, Accepted
  residualLikelihood Int?
  residualImpact     Int?
  residualScore      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── QMS: Quality Policy Acknowledgement ───
model PolicyAcknowledgement {
  id            String   @id @default(cuid())
  userId        String
  userEmail     String
  userName      String
  policyVersion String   @default("1.0")
  acknowledgedAt DateTime @default(now())
}

// ─── QMS: Continual Improvement Log ───
model ImprovementItem {
  id            String   @id @default(cuid())
  title         String
  description   String
  submittedBy   String
  source        String   // Staff Suggestion, Management Review, Audit Finding, Customer Feedback, NCR, Process Review
  category      String?  // Process, Technology, Training, Communication, Documentation
  priority      String   @default("Medium") // Low, Medium, High
  assignedTo    String?
  status        String   @default("Proposed") // Proposed, Approved, In Progress, Completed, Rejected
  outcome       String?
  completedDate DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Supply Agreements (Onboarding) ───
model SupplyAgreement {
  id              String   @id @default(cuid())
  // Company details
  companyName     String
  companyAddress  String?
  companyRegNo    String?
  contactName     String
  contactEmail    String
  contactPhone    String?
  // Supply details
  supplyOf        String?   // e.g. "Bolting Technicians"
  siteLocation    String?
  startDate       DateTime?
  // Rates (stored as JSON)
  rates           String?   // JSON array of {description, rate, basis}
  breakdown       String?   // JSON array of strings
  additionalInfo  String?
  // Contractor personal details (if individual)
  firstName       String?
  lastName        String?
  dateOfBirth     DateTime?
  niNumber        String?
  utrNumber       String?
  address         String?
  postcode        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  // Status
  status          String   @default("Pending")  // Pending, Reviewed, Approved, Rejected
  reviewedBy      String?
  reviewedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── QMS Document Repository ───
model QmsDocument {
  id          String   @id @default(cuid())
  fileName    String
  filePath    String   // display path e.g. "1. Context of Organisation/Interested Parties"
  folder      String   // top-level folder
  subfolder   String?  // sub-folder if any
  fileType    String   // docx, xlsx, pptx, pdf
  fileSize    Int      @default(0)
  r2Key       String?  // Cloudflare R2 storage key
  uploadedBy  String?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Agentic Workflow Engine ───
model WorkflowLog {
  id        String   @id @default(cuid())
  workflow  String   // "compliance-chase" | "welcome-agent" | "stale-applicant"
  action    String   // human-readable description
  target    String?  // contractor id or email
  outcome   String   // "sent" | "skipped" | "failed" | "escalated"
  detail    String?  // extra context
  createdAt DateTime @default(now())

  @@index([workflow])
  @@index([createdAt])
  @@index([target])
}

// ─── Auditor Users (external auditors) ───
model AuditorUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  organisation String    @default("Nutral")
  logoUrl      String?   @default("/nutral-logo.svg")
  role         String    @default("auditor")
  loginToken   String?   @unique  // magic-link token — bypasses password
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─── Job Roles (admin-managed trade/role catalogue) ───
model JobRole {
  id          String               @id @default(cuid())
  name        String               @unique
  active      Boolean              @default(true)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  contractors ContractorJobRole[]
}

// ─── Contractor <-> Job Role (many-to-many join) ───
model ContractorJobRole {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  jobRoleId    String
  jobRole      JobRole    @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([contractorId, jobRoleId])
}

// ─── Customer Satisfaction Survey (public /survey form) ───
model CustomerSurvey {
  id                   String   @id @default(cuid())
  companyName          String
  contactName          String
  contactEmail         String
  dateOfService        String?  // yyyy-mm-dd as submitted
  overallSatisfaction  Int      // 1-5
  qualityOfWorkers     Int?
  communication        Int?
  compliance           Int?
  valueForMoney        Int?
  recommend            String?  // Yes, No, Maybe
  whatDidWell          String?
  whatToImprove        String?
  otherComments        String?
  status               String   @default("New") // New, Reviewed, Actioned
  createdAt            DateTime @default(now())

  @@index([status, createdAt])
}

// ─── Supplier Questionnaire (ISO 9001 clause 8.4 supplier approval record) ───
model SupplierQuestionnaire {
  id                          String    @id @default(cuid())
  companyName                 String
  tradingName                 String?
  companyRegNo                String?
  vatNumber                   String?
  registeredAddress           String?
  mainContactName             String
  contactEmail                String
  contactPhone                String?
  website                     String?
  goodsServices               String
  numberOfEmployees           String?
  yearsInBusiness             String?
  iso9001                     String?   // Yes, No, Working towards
  otherCertifications         String?
  publicLiability             String?
  publicLiabilityAmount       String?
  employersLiability          String?
  employersLiabilityAmount    String?
  professionalIndemnity       String?
  professionalIndemnityAmount String?
  healthSafetyPolicy          String?
  environmentalPolicy         String?
  equalityPolicy              String?
  ref1Company                 String?
  ref1Contact                 String?
  ref1Email                   String?
  ref1Phone                   String?
  ref2Company                 String?
  ref2Contact                 String?
  ref2Email                   String?
  ref2Phone                   String?
  additionalInfo              String?
  declaration                 Boolean   @default(false)
  signature                   String?
  submittedDate               DateTime?
  status                      String    @default("New") // New, Approved, Rejected
  reviewedBy                  String?
  reviewedAt                  DateTime?
  notes                       String?
  createdAt                   DateTime  @default(now())

  @@index([status, createdAt])
}

// ─── Outbound Email Log (every send recorded so failures cannot go silent) ───
model EmailLog {
  id         String   @id @default(cuid())
  to         String   // comma-joined recipients
  subject    String
  template   String?  // send-site slug, e.g. "application-received"
  status     String   // sent, failed
  provider   String?  // graph (Microsoft 365) or resend
  error      String?
  providerId String?  // Resend message id; Graph sendMail returns 202 with no id
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
}
