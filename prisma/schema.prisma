generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users (internal staff) ───
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin") // admin, manager, viewer
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Client Companies ───
model Company {
  id           String       @id @default(cuid())
  name         String
  address      String?
  city         String?
  postcode     String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  contractors   Assignment[]
  requirements  ComplianceRequirement[]
  approvalChain ApprovalChain?
  invoices      Invoice[]
}

// ─── Suppliers (agencies) ───
model Supplier {
  id           String       @id @default(cuid())
  name         String
  tier         String       @default("Tier 2") // Tier 1, Tier 2, Tier 3
  contactName  String?
  contactEmail String?
  contactPhone String?
  score        Int          @default(0) // 0-100 performance score
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  contractors  Contractor[]
}

// ─── Contractors ───
model Contractor {
  id           String             @id @default(cuid())
  firstName    String
  lastName     String
  email        String             @unique
  phone        String?
  jobTitle     String?
  dayRate      Float?
  payRate      Float?             // hourly pay rate
  chargeRate   Float?             // hourly charge rate
  status       String             @default("Active") // Active, Inactive, On Hold
  supplierId   String?
  supplier     Supplier?          @relation(fields: [supplierId], references: [id])
  niNumber     String?
  utrNumber    String?
  ir35Status   String?            // Inside, Outside, TBD
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  assignments  Assignment[]
  timesheets   Timesheet[]
  compliances      ComplianceRecord[]
  invoiceLines     InvoiceLine[]
  contractorLogin  ContractorLogin?
  documents        Document[]
}

// ─── Assignments (contractor <-> company placement) ───
model Assignment {
  id           String      @id @default(cuid())
  contractorId String
  contractor   Contractor  @relation(fields: [contractorId], references: [id])
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  role         String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  status       String      @default("Active") // Placed, Active, Ending, Completed
  poNumber     String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  timesheets   Timesheet[]
}

// ─── Timesheets ───
model Timesheet {
  id           String          @id @default(cuid())
  contractorId String
  contractor   Contractor      @relation(fields: [contractorId], references: [id])
  assignmentId String?
  assignment   Assignment?     @relation(fields: [assignmentId], references: [id])
  weekStarting DateTime        // Monday of the week
  status       String          @default("Draft") // Draft, Submitted, Approved, Rejected
  totalHours   Float           @default(0)
  overtimeHours Float          @default(0)
  notes        String?
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  isException     Boolean         @default(false)
  exceptionReason String?
  entries         TimesheetEntry[]
  auditLogs       TimesheetAuditLog[]
  approvals       TimesheetApproval[]
}

model TimesheetEntry {
  id          String    @id @default(cuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  dayOfWeek   Int       // 0=Mon, 1=Tue, ... 6=Sun
  hours       Float     @default(0)
  overtime    Float     @default(0)
  notes       String?
}

// ─── Compliance Records ───
model ComplianceRecord {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id])
  type         String     // CSCS, DBS, Right to Work, Insurance, IR35, Qualification
  documentName String?
  reference    String?    // cert number etc
  issueDate    DateTime?
  expiryDate   DateTime?
  status       String     @default("Pending") // Verified, Pending, Expiring, Expired, Non-Compliant
  notes        String?
  filePath     String?    // path to uploaded document
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ─── Compliance Requirements (checklists per role/site) ───
model ComplianceRequirement {
  id          String   @id @default(cuid())
  role        String   // e.g. "Electrician", "Labourer", "All"
  companyId   String?  // null = applies to all sites
  company     Company? @relation(fields: [companyId], references: [id])
  type        String   // CSCS, DBS, Right to Work, Insurance, IR35 Assessment, Qualification
  description String?  // extra detail, e.g. "NVQ Level 3"
  isMandatory Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([role, companyId, type])
}

// ─── Timesheet Audit Log ───
model TimesheetAuditLog {
  id          String    @id @default(cuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  action      String    // Created, Edited, Submitted, Approved, Rejected, AutoApproved, Reopened
  field       String?   // which field changed (e.g. "hours_Mon", "status")
  oldValue    String?
  newValue    String?
  userId      String?   // who made the change
  userName    String?
  createdAt   DateTime  @default(now())
}

// ─── Approval Chains (multi-step approval per company) ───
model ApprovalChain {
  id        String         @id @default(cuid())
  companyId String?        @unique // null = default chain for all companies
  company   Company?       @relation(fields: [companyId], references: [id])
  name      String
  steps     ApprovalStep[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ApprovalStep {
  id              String        @id @default(cuid())
  approvalChainId String
  approvalChain   ApprovalChain @relation(fields: [approvalChainId], references: [id], onDelete: Cascade)
  stepOrder       Int           // 1, 2, 3...
  approverRole    String        // "manager", "admin"
  label           String        // "Line Manager", "Site Manager", "Finance"
  createdAt       DateTime      @default(now())
}

// ─── Timesheet Approval Steps (per-timesheet tracking) ───
model TimesheetApproval {
  id          String    @id @default(cuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  stepOrder   Int
  stepLabel   String
  status      String    @default("Pending") // Pending, Approved, Rejected
  approvedBy  String?
  approverName String?
  approvedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
}

// ─── Invoices ───
model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique // e.g. INV-0001
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  periodStart    DateTime      // billing period start
  periodEnd      DateTime      // billing period end
  status         String        @default("Draft") // Draft, Reconciling, Approved, Sent, Paid, Disputed
  currency       String        @default("GBP")
  subtotal       Float         @default(0)
  vatRate        Float         @default(20) // UK VAT %
  vatAmount      Float         @default(0)
  total          Float         @default(0)
  dueDate        DateTime?
  paidDate       DateTime?
  poNumber       String?       // PO reference for three-way matching
  notes          String?
  matchStatus    String        @default("Unmatched") // Unmatched, Partial, Matched, Disputed
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lines          InvoiceLine[]
}

model InvoiceLine {
  id            String    @id @default(cuid())
  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id])
  timesheetId   String?
  description   String     // e.g. "J. Smith - Electrician"
  hours         Float
  overtimeHours Float      @default(0)
  rate          Float      // charge rate per hour
  overtimeRate  Float?     // overtime rate (1.5x)
  amount        Float      // total line amount
  createdAt     DateTime   @default(now())
}

// ─── Activity Log (tracks all user actions for audit) ───
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  userEmail   String?
  action      String   // e.g. "Created Contractor", "Approved Timesheet"
  entityType  String   // e.g. "Contractor", "Timesheet", "Invoice"
  entityId    String?
  details     String?  // JSON or text with additional context
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// ─── Contractor Login (self-service portal) ───
model ContractorLogin {
  id           String     @id @default(cuid())
  contractorId String     @unique
  contractor   Contractor @relation(fields: [contractorId], references: [id])
  email        String     @unique
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ─── Password Reset Tokens ───
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Document Uploads ───
model Document {
  id            String     @id @default(cuid())
  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id])
  type          String     // CSCS, CV, P45, P60, Passport, DBS, Insurance, Qualification, Other
  fileName      String
  fileSize      Int        // bytes
  mimeType      String
  storageKey    String     // R2 object key
  storageUrl    String?    // public URL if needed
  version       Int        @default(1)
  uploadedBy    String?    // "contractor" or user email
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// ─── Push Notification Subscriptions ───
model PushSubscription {
  id             String   @id @default(cuid())
  contractorId   String?
  userId         String?
  endpoint       String   @unique
  p256dh         String
  auth           String
  createdAt      DateTime @default(now())
}

// ─── Notifications ───
model Notification {
  id            String   @id @default(cuid())
  recipientType String   // "contractor" or "user"
  recipientId   String
  title         String
  body          String
  url           String?  // link to open when tapped
  isRead        Boolean  @default(false)
  sentAt        DateTime @default(now())
}

// ─── Rate Cards ───
model RateCard {
  id         String   @id @default(cuid())
  role       String
  location   String?
  payRate    Float    // per hour
  chargeRate Float    // per hour
  margin     Float?   // percentage
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
