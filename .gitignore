# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
prisma/dev.db
prisma/dev.db-journal
dev.db

# Generator scripts (one-time use, regenerate with Claude)
create-*.js
generate-*.js

# Data files
contractor-data.json
*.db

# Generated documents at root (local use only — tracked versions live in docs/)
/*.docx
/*.pptx
/*.xlsx

# Claude local settings
.claude/settings.local.json

# Agent working directories — scratch state, not project history
.foreman/
tmp/

# Zero-byte files whose NAMES are shell metacharacters, left behind when a
# command's quoting goes wrong (`{,` `{,+` `40\`` and friends). Turbopack hard-
# panics on them, so they must never reach a commit. Ignoring is a backstop —
# delete them by exact name, and never `git add .`.
[{}]*
*\`*

# Binary assets in public/ trip Tailwind v4's content scanner (byte sequences
# get misread as arbitrary-value class candidates) — excluded from scanning.
public/*.eps
public/*.docx

# Contains a hardcoded production Postgres connection string. Superseded by
# scripts/smoke-prism.mjs, which takes the credential from the environment
# (run it via `railway run --service Postgres`) instead of storing one.
scripts/smoke-timesheets.mjs

.vercel
.env*

# ruflo (claude-flow) runtime state. Never commit; also keeps Tailwind from
# scanning its locked HNSW index, which crashes `next build` on Windows.
.swarm/
.claude-flow/
